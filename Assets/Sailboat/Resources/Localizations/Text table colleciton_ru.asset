  m_TableData:
  - m_Id: 219678528991232
    m_Localized: "\u0424\u0415\u0420\u041D\u0412\u0415"
    m_Metadata:
      m_Items: []
  - m_Id: 223046068563968
    m_Localized: "\u041E\u043A\u0435\u0430\u043D \u2014\r\n\u0432\u043B\u0430\u0441\u0442\u043D\u0430\u044F,
      \u043D\u0435\u0443\u043A\u0440\u043E\u0442\u0438\u043C\u0430\u044F \u0441\u0438\u043B\u0430.\r\n\r\n\u041D\u0438\u043A\u0442\u043E
      \u043D\u0435 \u043E\u0441\u043C\u0435\u043B\u0438\u0432\u0430\u043B\u0441\u044F
      \u0431\u0440\u043E\u0441\u0438\u0442\u044C \u0432\u044B\u0437\u043E\u0432 \u0435\u0433\u043E
      \u0432\u043B\u0430\u0441\u0442\u0438.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 228932711313408
    m_Localized: "\u041D\u0430\u0432\u0435\u0434\u0438 \u043A\u0443\u0440\u0441\u043E\u0440
      \u0441\u044E\u0434\u0430 \u0438 \u043D\u0430\u0436\u043C\u0438 [\u041F\u0440\u043E\u0431\u0435\u043B],
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u0442\u043E\u043B\u043A\u043D\u0443\u0442\u044C
      \u043F\u043B\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 243295719485440
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 [j], \u0447\u0442\u043E\u0431\u044B
      \u043E\u0442\u043A\u0440\u044B\u0442\u044C \u0436\u0443\u0440\u043D\u0430\u043B
      \u043F\u043B\u0430\u0432\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 243434378981376
    m_Localized: "\u0413\u0440\u043E\u043C\u043A\u043E\u0441\u0442\u044C \u0437\u0432\u0443\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 243558148698112
    m_Localized: "[\u041F\u0440\u043E\u0431\u0435\u043B] \u0441\u043B\u0435\u0433\u043A\u0430
      \u043F\u043E\u0434\u0442\u043E\u043B\u043A\u043D\u0443\u0442\u044C \u043F\u043B\u043E\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 243620861931520
    m_Localized: "\u0422\u044B \u0441\u0434\u0435\u043B\u0430\u043B \u044D\u0442\u043E\u0442
      \u043F\u043B\u043E\u0442 \u0441\u0430\u043C. \u0422\u0432\u043E\u0439 \u0434\u0435\u0434\u0443\u0448\u043A\u0430
      \u0436\u0438\u0432\u0451\u0442 \u043F\u043E \u0442\u0443 \u0441\u0442\u043E\u0440\u043E\u043D\u0443
      \u043F\u0440\u043E\u043B\u0438\u0432\u0430, \u0438 \u0442\u044B \u0441 \u0434\u0435\u0442\u0441\u0442\u0432\u0430
      \u0445\u043E\u0442\u0435\u043B \u043D\u0430\u0432\u0435\u0441\u0442\u0438\u0442\u044C
      \u0435\u0433\u043E \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E.
      \u0425\u043E\u0442\u044F \u0443 \u0440\u044B\u0431\u0430\u043A\u043E\u0432
      \u0432 \u0442\u0432\u043E\u0435\u0439 \u0434\u0435\u0440\u0435\u0432\u043D\u0435
      \u0438 \u0435\u0441\u0442\u044C \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u0435
      \u043B\u043E\u0434\u043A\u0438, \u0438\u0445 \u043E\u0447\u0435\u043D\u044C
      \u043C\u0430\u043B\u043E.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 243990623383552
    m_Localized: "\u041D\u0430\u0436\u043C\u0438 [Q], \u0447\u0442\u043E\u0431\u044B
      \u043F\u043E\u0434\u0442\u044F\u043D\u0443\u0442\u044C \u0438\u043B\u0438 \u0443\u0431\u0440\u0430\u0442\u044C
      \u043F\u0430\u0440\u0443\u0441\n\n\u041F\u0430\u0440\u0443\u0441 \u0432\u0441\u0435\u0433\u0434\u0430
      \u043F\u043E\u0432\u0451\u0440\u043D\u0443\u0442 \u043A \u043A\u0443\u0440\u0441\u043E\u0440\u0443\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 244062887047168
    m_Localized: "\u0423 \u0442\u0435\u0431\u044F \u0432\u0441\u0435\u0433\u0434\u0430
      \u0431\u044B\u043B\u0430 \u044D\u0442\u0430 \u043C\u044B\u0441\u043B\u044C:
      \u0430 \u0447\u0442\u043E \u0435\u0441\u043B\u0438\u2026 \u043B\u043E\u0434\u043A\u0443
      \u0431\u0443\u0434\u0435\u0442 \u0434\u0432\u0438\u0433\u0430\u0442\u044C \u0438\u043C\u0435\u043D\u043D\u043E
      \u0432\u0435\u0442\u0435\u0440? \u0417\u0432\u0443\u0447\u0438\u0442 \u043A\u0430\u043A
      \u0441\u043A\u0430\u0437\u043A\u0430. \u0422\u044B \u043F\u043E\u043F\u044B\u0442\u0430\u043B\u0441\u044F
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u043F\u0440\u043E\u0447\u043D\u044B\u0439
      \u0442\u043A\u0430\u043D\u0435\u0432\u044B\u0439 \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B
      \u0438, \u043D\u0430\u043A\u043E\u043D\u0435\u0446, \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u0438\u043B
      \u0435\u0433\u043E \u043A \u043F\u043B\u043E\u0442\u0443. \u041C\u043E\u0436\u0435\u0442
      \u0431\u044B\u0442\u044C, \u0442\u0435\u043F\u0435\u0440\u044C \u0442\u044B
      \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u0435\u0440\u0435\u0441\u0435\u0447\u044C
      \u044D\u0442\u0438 \u0432\u043E\u0434\u044B.\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 244274506461184
    m_Localized: "\u041F\u0435\u0440\u0435\u0437\u0430\u043F\u0443\u0441\u0438\u0442\u044C
      \u0423\u0440\u043E\u0432\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 244706813374464
    m_Localized: "\u0414\u0432\u0438\u0433\u0430\u0439 \u043C\u044B\u0448\u044C\u044E,
      \u0447\u0442\u043E\u0431\u044B \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C
      \u043F\u0430\u0440\u0443\u0441\u043E\u043C\r\n[Q] \u043F\u043E\u0434\u0442\u044F\u043D\u0443\u0442\u044C/\u0443\u0431\u0440\u0430\u0442\u044C
      \u043F\u0430\u0440\u0443\u0441\r\n[\u041F\u0440\u043E\u0431\u0435\u043B] \u0441\u043B\u0435\u0433\u043A\u0430
      \u043F\u043E\u0434\u0442\u043E\u043B\u043A\u043D\u0443\u0442\u044C \u043F\u043B\u043E\u0442\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 244785913753600
    m_Localized: "\u0422\u0432\u043E\u0439 \u0434\u0435\u0434\u0443\u0448\u043A\u0430
      \u0431\u044B\u043B \u043F\u043E\u0440\u0430\u0436\u0451\u043D, \u0443\u0432\u0438\u0434\u0435\u0432,
      \u043A\u0430\u043A \u0431\u0435\u043B\u044B\u0435 \u043F\u043E\u043B\u043E\u0442\u043D\u0438\u0449\u0430
      \u0434\u0432\u0438\u0433\u0430\u044E\u0442 \u0442\u0432\u043E\u0435 \u0441\u0443\u0434\u043D\u043E.
      \xAB\u0412\u0435\u0442\u0435\u0440 \u2014 \u0432\u043E\u0442 \u0447\u0435\u0433\u043E
      \u0441\u0442\u043E\u0438\u0442 \u0431\u043E\u044F\u0442\u044C\u0441\u044F,
      \u043C\u0430\u043B\u044C\u0447\u0438\u043A. \u041D\u0435 \u0441\u0430\u043C\u0438\u0445
      \u0432\u043E\u0434\xBB, \u2014 \u0441\u043A\u0430\u0437\u0430\u043B \u043E\u043D.\n\n\u0418
      \u0432\u0441\u0451 \u0436\u0435 \u043D\u0430 \u044D\u0442\u043E\u0442 \u0440\u0430\u0437
      \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u0447\u0442\u043E \u0432\u0435\u0442\u0435\u0440
      \u043C\u043E\u0436\u0435\u0442 \u0442\u0435\u0431\u0435 \u043F\u043E\u043C\u043E\u0447\u044C
      \u2014 \u0435\u0441\u043B\u0438 \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u0435\u0448\u044C
      \u0435\u0433\u043E \u043F\u0443\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 245508030296064
    m_Localized: "\u041D\u0430\u0436\u0438\u043C\u0430\u0439 [A] \u0438 [D], \u0447\u0442\u043E\u0431\u044B
      \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C \u043B\u043E\u0434\u043A\u043E\u0439,\n[Q]
      \u043F\u043E\u0434\u0442\u044F\u043D\u0443\u0442\u044C/\u0443\u0431\u0440\u0430\u0442\u044C
      \u043F\u0430\u0440\u0443\u0441,\r\n[\u041F\u0440\u043E\u0431\u0435\u043B],
      \u0447\u0442\u043E\u0431\u044B \u043F\u043E\u0434\u0442\u043E\u043B\u043A\u043D\u0443\u0442\u044C
      \u0432\u043F\u0435\u0440\u0451\u0434\r\n"
    m_Metadata:
      m_Items: []
  - m_Id: 245527877742592
    m_Localized: "\u041B\u043E\u0434\u043A\u0430, \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
      \u0441\u0432\u043E\u0435\u0439 \u0444\u043E\u0440\u043C\u0435 \u0438 \u0432\u043E\u0434\u044F\u043D\u043E\u043C\u0443
      \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u044E,
      \u043C\u043E\u0436\u0435\u0442 \u201C\u0440\u0435\u0437\u0430\u0442\u044C\u201D
      \u043F\u043E\u0434 \u0431\u043E\u043B\u044C\u0448\u0438\u043C\u0438 \u0443\u0433\u043B\u0430\u043C\u0438
      \u043A \u0432\u0435\u0442\u0440\u0443 \u0438 \u0434\u0430\u0436\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0438\u0434\u0442\u0438 \u043F\u0440\u043E\u0442\u0438\u0432 \u043D\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 245592423886848
    m_Localized: "\u0414\u0432\u0438\u0433\u0430\u0439 \u043C\u044B\u0448\u044C\u044E,
      \u0447\u0442\u043E\u0431\u044B \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C
      \u043F\u0430\u0440\u0443\u0441\u043E\u043C\r\n[Q] \u043F\u043E\u0434\u0442\u044F\u043D\u0443\u0442\u044C/\u0443\u0431\u0440\u0430\u0442\u044C
      \u043F\u0430\u0440\u0443\u0441\r\n[\u041F\u0440\u043E\u0431\u0435\u043B] \u0441\u043B\u0435\u0433\u043A\u0430
      \u043F\u043E\u0434\u0442\u043E\u043B\u043A\u043D\u0443\u0442\u044C \u043F\u043B\u043E\u0442/\u043B\u043E\u0434\u043A\u0443\r\n[A/D]
      \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C \u043B\u043E\u0434\u043A\u043E\u0439\r"
    m_Metadata:
      m_Items: []
  - m_Id: 245622421549056
    m_Localized: "\u0420\u044B\u0431\u0430\u043A\u0438 \u0438\u0437 \u0442\u0432\u043E\u0435\u0433\u043E
      \u0430\u0440\u0445\u0438\u043F\u0435\u043B\u0430\u0433\u0430 \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0432 \u043B\u043E\u0432\u0443\u0448\u043A\u0435 \u0438\u0437-\u0437\u0430
      \u043E\u043F\u0430\u0441\u043D\u043E\u0433\u043E \u0432\u0435\u0442\u0440\u0430.
      \u041F\u0440\u0438\u0448\u043B\u043E \u0432\u0440\u0435\u043C\u044F \u0434\u043E\u043A\u0430\u0437\u0430\u0442\u044C,
      \u0447\u0442\u043E \u0442\u0432\u043E\u0435 \u0438\u0437\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u0438\u0435
      \u043F\u043E\u043B\u0435\u0437\u043D\u043E. \u0421 \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E
      \u0440\u0430\u0437\u0430 \u0442\u044B \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u043B
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0443\u044E \u043B\u043E\u0434\u043A\u0443
      \u0438 \u043F\u0440\u0438\u043A\u0440\u0435\u043F\u0438\u043B \u043A \u043D\u0435\u0439
      \u0441\u0432\u043E\u0439 \u043F\u0430\u0440\u0443\u0441. \u0422\u044B \u043D\u0430\u0437\u0432\u0430\u043B
      \u044D\u0442\u043E \u0438\u0437\u043E\u0431\u0440\u0435\u0442\u0435\u043D\u0438\u0435
      \xAB\u043F\u0430\u0440\u0443\u0441\u043D\u0438\u043A\xBB."
    m_Metadata:
      m_Items: []
  - m_Id: 246017818587136
    m_Localized: "\u0414\u043E\u0432\u0435\u0437\u0438 \u0440\u044B\u0431\u0430\u043A\u043E\u0432
      \u0434\u043E \u0438\u0445 \u043E\u0441\u0442\u0440\u043E\u0432\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 246156402585600
    m_Localized: "\u0422\u0432\u043E\u0438 \u0441\u043C\u0435\u043B\u044B\u0435 \u0438\u0434\u0435\u0438
      \u0431\u044B\u043B\u0438 \u043F\u0440\u0438\u043D\u044F\u0442\u044B \u0432
      \u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435. \u041F\u0430\u0440\u0430
      \u0440\u044B\u0431\u0430\u043A\u043E\u0432 \u0434\u0430\u0436\u0435 \u043F\u043E\u043F\u0440\u043E\u0441\u0438\u043B\u0438
      \u0442\u0435\u0431\u044F \u0434\u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
      \u0438\u0445 \u0434\u043E\u043C\u043E\u0439, \u043D\u0430 \u043E\u0441\u0442\u0440\u043E\u0432\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 252475809427456
    m_Localized: "\u041A\u041E\u041D\u0415\u0426"
    m_Metadata:
